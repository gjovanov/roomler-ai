# FR-135 §7.1 — the ratchet's baseline (scripts/rc-media-ratchet.sh). A count
# may only fall. One that must rise raises its line here in the same PR, with
# the ledger row it adds and when that row retires:
#   pump_lines_ffmpeg_dc=3950 # r0:FOO-1: retires with R8's delete
# Set at FR-135 R0b, on the instruments it added to both data-channel pumps.
agent_env_reads=182 # p4:DEADLINE-1: retires with FR-148 P5, when the deadline channel's switch is deleted
viewer_knobs=32 # r0:CLOCK-1: retires after a week of field reads with the calibration on
pump_lines_rtp=1312
pump_lines_vp9_dc=1539 # r4a:WAIT-1: retires with #3275's delete, when the sleeping arm and the switch's conditional go
pump_lines_ffmpeg_dc=3895 # r4a:WAIT-1: retires with #3275's delete, when the sleeping arm and the switch's conditional go
