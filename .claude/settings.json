{
    "env": {
        "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0",
        "CLAUDE_CODE_EFFORT_LEVEL": "max"
    },
    "permissions": {
        "defaultMode": "bypassPermissions"
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/gh-account-guard.sh\""
                    }
                ]
            }
        ]
    }
}
