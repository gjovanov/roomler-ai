+/// Queues one small message of each of `sizes` bytes, numbered from 0.
+async fn fill(pq: &PendingQueue, wake: &tokio::sync::mpsc::Sender<()>, sizes: &[usize]) {
+    for (ssn, &len) in sizes.iter().enumerate() {
