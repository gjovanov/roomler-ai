+/// roomler fork — a FORWARD-TSN followed by a bundled chunk in the SAME
+/// buffer (what `Packet::unmarshal` hands every chunk parser: the remainder
+/// of the packet) must parse ITS stream entries only. Upstream counted to
+/// the end of the buffer, ran into the next chunk, and failed the packet.
+#[test]
+fn test_chunk_forward_tsn_ignores_bundled_trailing_chunk() -> Result<()> {
+    // FORWARD-TSN (len 12: new cumulative TSN 3, one stream 4/5) followed by
+    // a SACK (type 3, len 16) — the shape dcSCTP sends when it abandons a
+    // message on an unreliable stream.
+    let bundled = Bytes::from_static(&[
+        0xc0, 0x0, 0x0, 0xc, 0x0, 0x0, 0x0, 0x3, 0x0, 0x4, 0x0, 0x5, // FORWARD-TSN
+        0x3, 0x0, 0x0, 0x10, 0x0, 0x0, 0x0, 0x9, 0x0, 0x0, 0x4, 0x0, 0x0, 0x0, 0x0, 0x0, // SACK
+    ]);
+    let actual = ChunkForwardTsn::unmarshal(&bundled)?;
+    assert_eq!(actual.new_cumulative_tsn, 3);
+    assert_eq!(actual.streams.len(), 1, "only this chunk's entries");
+    assert_eq!(actual.streams[0].identifier, 4);
+    assert_eq!(actual.streams[0].sequence, 5);
+    assert_eq!(
+        actual.value_length(),
+        8,
+        "the packet loop must advance by the chunk, not by the buffer"
+    );
+    Ok(())
+}
+
+/// roomler fork — and the packet level: both chunks come out.
+#[test]
+fn test_packet_with_forward_tsn_then_another_chunk_parses_both() -> Result<()> {
+    use crate::packet::Packet;
+    let fwd = ChunkForwardTsn {
+        new_cumulative_tsn: 3,
+        streams: vec![ChunkForwardTsnStream {
+            identifier: 4,
+            sequence: 5,
+        }],
+    };
+    let trailing = ChunkForwardTsn {
+        new_cumulative_tsn: 9,
+        streams: vec![],
+    };
+    let packet = Packet {
+        source_port: 5000,
+        destination_port: 5000,
+        verification_tag: 0x1234_5678,
+        chunks: vec![Box::new(fwd), Box::new(trailing)],
+    };
+    let raw = packet.marshal()?;
+    let parsed = Packet::unmarshal(&raw)?;
+    assert_eq!(parsed.chunks.len(), 2, "the chunk after a FORWARD-TSN survives");
+    assert_eq!(parsed.chunks[0].header().typ, CT_FORWARD_TSN);
+    assert_eq!(parsed.chunks[1].header().typ, CT_FORWARD_TSN);
+    Ok(())
+}
