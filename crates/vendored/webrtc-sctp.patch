+/// Takes everything out of `queue` the way the association's write loop does.
+fn drain(queue: &PendingQueue) -> Vec<ChunkPayloadData> {
+    let mut out = Vec::new();
+    while let Some(c) = queue.peek() {
+        match queue.pop(c.beginning_fragment, c.unordered) {
+            Some(c) => out.push(c),
+            None => break,
+        }
+    }
+    out
