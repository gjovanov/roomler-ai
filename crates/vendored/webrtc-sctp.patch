+    assert!(
+        findings.is_empty(),
+        "#3755, a message larger than the queue on a quiet association:\n  - {}",
+        findings.join("\n  - ")
+    );
+    Ok(())
+}
+
+/// What one write of the AC3 writers came to.
+#[derive(Clone, Debug, PartialEq)]
+enum CutWrite {
+    /// It returned `Ok`: its message must be read, in its place.
+    Written,
+    /// It was cut at a wait: its message is never read, or read whole, once.
+    Cut,
+    /// It returned an error.
+    Failed(String),
+    /// It was awaited to its end and did not end within its ceiling.
+    Hung,
+}
+
+/// splitmix64: the AC3 writers' seeded choices, the same on every run.
+struct SplitMix64(u64);
+
+impl SplitMix64 {
+    fn below(&mut self, n: u64) -> u64 {
+        self.0 = self.0.wrapping_add(0x9e37_79b9_7f4a_7c15);
+        let mut z = self.0;
+        z = (z ^ (z >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+        (z ^ (z >> 31)) % n
+    }
+}
+
+/// Message `i` of writer `w`, `len` bytes: the writer, the index and the length
+/// up front, then bytes that only this message carries at those offsets.
+fn cut_test_message(w: u8, i: u32, len: usize) -> Bytes {
+    let mut m = Vec::with_capacity(len);
+    m.push(w);
+    m.extend_from_slice(&i.to_le_bytes());
+    m.extend_from_slice(&(len as u32).to_le_bytes());
+    while m.len() < len {
+        let k = m.len();
+        m.push(((usize::from(w) * 31 + i as usize * 7 + k) % 251) as u8);
+    }
+    m.into()
+}
+
+/// The writer and index of a whole message of `cut_test_message`, or `None`
+/// for anything else (a part of one included).
+fn parse_cut_test_message(m: &[u8]) -> Option<(u8, u32)> {
+    if m.len() < 9 {
+        return None;
+    }
+    let w = m[0];
+    let i = u32::from_le_bytes(m[1..5].try_into().ok()?);
+    let len = u32::from_le_bytes(m[5..9].try_into().ok()?) as usize;
+    if len != m.len() {
+        return None;
+    }
+    let whole = m[9..]
+        .iter()
+        .enumerate()
+        .all(|(j, &b)| b == ((usize::from(w) * 31 + i as usize * 7 + 9 + j) % 251) as u8);
+    whole.then_some((w, i))
+}
+
+/// The AC3 property over what the writers logged and what the peer read.
+/// `returned_order`: the log is in the order the writes were queued, as on a
+/// runtime of one thread, so the writes that returned `Ok` are read in it.
+fn check_cut_writes(
+    log: &[(u8, u32, CutWrite)],
+    read: &[Vec<u8>],
+    returned_order: bool,
+) -> Vec<String> {
+    let mut findings = Vec::new();
+    let mut seen = std::collections::HashSet::new();
+    let mut last_of: HashMap<u8, u32> = HashMap::new();
+    let mut read_ids = Vec::new();
+    for (k, m) in read.iter().enumerate() {
+        let Some((w, i)) = parse_cut_test_message(m) else {
+            findings.push(format!(
+                "read #{k} ({} bytes) is not a whole message",
+                m.len()
+            ));
+            continue;
+        };
+        if !seen.insert((w, i)) {
+            findings.push(format!("message {w}/{i} was read twice"));
+        }
+        if let Some(&last) = last_of.get(&w) {
+            if i <= last {
+                findings.push(format!(
+                    "writer {w}'s message {i} was read after its message {last}"
+                ));
+            }
+        }
+        last_of.insert(w, i);
+        read_ids.push((w, i));
+    }
+
+    let written: Vec<(u8, u32)> = log
+        .iter()
+        .filter(|(_, _, o)| *o == CutWrite::Written)
+        .map(|(w, i, _)| (*w, *i))
+        .collect();
+    let missing: Vec<&(u8, u32)> = written.iter().filter(|id| !seen.contains(*id)).collect();
+    if let Some(first) = missing.first() {
+        findings.push(format!(
+            "{} of the {} writes that returned Ok were never read, the first {}/{}",
+            missing.len(),
+            written.len(),
+            first.0,
+            first.1
+        ));
+    } else if returned_order {
+        let read_written: Vec<(u8, u32)> = read_ids
+            .iter()
+            .filter(|id| written.contains(id))
+            .copied()
+            .collect();
+        if read_written != written {
+            findings.push(
+                "the writes that returned Ok were read in another order than they returned"
+                    .to_owned(),
+            );
+        }
+    }
+    for (w, i, o) in log {
+        match o {
+            CutWrite::Failed(err) => findings.push(format!("write {w}/{i} failed: {err}")),
+            CutWrite::Hung => findings.push(format!(
+                "write {w}/{i} was awaited and never ended within its ceiling"
+            )),
+            CutWrite::Written | CutWrite::Cut => {}
+        }
+    }
+    findings
+}
+
+/// One round of AC3 with `seed`: the findings, none when the stream stayed
+/// whole.
+///
+/// The pending queue's overdraft is sampled while the writers run, and must
+/// stay within its bound at every sample: (1 + the large messages that began
+/// while something was owed) times the largest message, as the queue counts
+/// them (`PendingQueue::began_while_owed`). Each of those needs a `pop` that
+/// raced a drop (`BegunMessage`), which a runtime of one thread never runs
+/// (`one_thread`: the count must stay 0). Once the association drained, its
+/// accounting must be at rest.
+async fn cut_writes_round(seed: u64, one_thread: bool) -> Result<Vec<String>> {
+    const SI: u16 = 1;
+    const WRITERS: u8 = 3;
+    const WRITES: u32 = 20;
+
+    let (br, ca, cb) = Bridge::new(0, None, None);
+    let (a0, mut a1) =
+        create_new_association_pair(&br, Arc::new(ca), Arc::new(cb), AckMode::NoDelay, 0).await?;
+    a0.association_internal
+        .lock()
+        .await
+        .use_pending_queue_of(SMALL_QUEUE);
+
+    let mut findings: Vec<String> = Vec::new();
+    let outcome: Result<()> = async {
+        let (s0, s1) = establish_session_pair(&br, &a0, &mut a1, SI).await?;
+        let queue = Arc::clone(&s0.pending_queue);
+
+        // The queue's room and overdraft, sampled while the writers run: the
+        // most room seen, and the first overdraft past its bound. The count is
+        // read after the overdraft: a message is counted as it begins, before
+        // its drop can add its rest, and the count only grows, so the bound
+        // read is never older than the overdraft it checks.
+        let sampling = Arc::new(AtomicBool::new(true));
+        let sampler = tokio::spawn({
+            let queue = Arc::clone(&queue);
+            let sampling = Arc::clone(&sampling);
+            async move {
+                let (mut room, mut past) = (0, None);
+                while sampling.load(Ordering::SeqCst) {
+                    room = queue.room().max(room);
+                    let owed = queue.overdraft();
+                    let bound = (1 + queue.began_while_owed()) * LARGEST_CUT_TEST_MESSAGE;
+                    if owed > bound && past.is_none() {
+                        past = Some((owed, bound));
+                    }
+                    tokio::time::sleep(Duration::from_millis(1)).await;
+                }
+                (room, past)
+            }
+        });
+
+        // The link moves all along.
+        let link_up = Arc::new(AtomicBool::new(true));
+        let link = tokio::spawn({
+            let br = Arc::clone(&br);
+            let link_up = Arc::clone(&link_up);
+            async move {
+                while link_up.load(Ordering::SeqCst) {
+                    br.tick().await;
+                    tokio::time::sleep(Duration::from_millis(1)).await;
+                }
+            }
+        });
+
+        // What each write came to, logged in the poll it ended in: on this
+        // one-thread runtime, the order the writes that returned `Ok` were
+        // queued in.
+        let log: Arc<std::sync::Mutex<Vec<(u8, u32, CutWrite)>>> = Arc::default();
+        let writers: Vec<_> = (0..WRITERS)
+            .map(|w| {
+                let s0 = Arc::clone(&s0);
+                let log = Arc::clone(&log);
+                tokio::spawn(async move {
+                    let mut rng = SplitMix64(seed ^ (u64::from(w) << 32));
+                    for i in 0..WRITES {
+                        // One in four is large: queued chunk by chunk, and
+                        // most of them larger than the whole queue.
+                        let len = if rng.below(4) == 0 {
+                            5_500 + rng.below(14_500)
+                        } else {
+                            16 + rng.below(1_600)
+                        } as usize;
+                        let msg = cut_test_message(w, i, len);
+                        let waits = if rng.below(2) == 0 {
+                            0
+                        } else {
+                            1 + rng.below(3) as usize
+                        };
+                        let write = s0.write_sctp(&msg, PayloadProtocolIdentifier::Binary);
+                        let came_to = if waits == 0 {
+                            match tokio::time::timeout(Duration::from_secs(5), write).await {
+                                Ok(Ok(_)) => CutWrite::Written,
+                                Ok(Err(err)) => CutWrite::Failed(err.to_string()),
+                                Err(_) => CutWrite::Hung,
+                            }
+                        } else {
+                            match cut_at_wait(write, waits).await {
+                                Some(Ok(_)) => CutWrite::Written,
+                                Some(Err(err)) => CutWrite::Failed(err.to_string()),
+                                None => CutWrite::Cut,
+                            }
+                        };
+                        log.lock().unwrap().push((w, i, came_to));
+                    }
+                })
+            })
+            .collect();
+
+        // roomler (#3755): how every task of the round ended. A writer, the
+        // sampler or the link that panicked is a finding: a panic in the write
+        // path must fail the round, not leave its writes unlogged. A writer
+        // still running at the ceiling is a finding too, and is aborted then,
+        // the only abort the round makes.
+        let deadline = tokio::time::Instant::now() + Duration::from_secs(40);
+        for (w, mut writer) in (0..WRITERS).zip(writers) {
+            match tokio::time::timeout_at(deadline, &mut writer).await {
+                Ok(Ok(())) => {}
+                Ok(Err(err)) => findings.push(format!("writer {w} ended in: {err}")),
+                Err(_) => {
+                    writer.abort();
+                    findings.push(format!("writer {w} did not finish within 40 s"));
+                }
+            }
+        }
+        sampling.store(false, Ordering::SeqCst);
+        match sampler.await {
+            Ok((room, past)) => {
+                if room > SMALL_QUEUE {
+                    findings.push(format!(
+                        "the queue had room {room} while the writers ran, more than its {SMALL_QUEUE}"
+                    ));
+                }
+                if let Some((owed, bound)) = past {
+                    findings.push(format!(
+                        "the queue owed {owed} bytes while the writers ran, more than its bound {bound}"
+                    ));
+                }
+            }
+            Err(err) => findings.push(format!("the sampler ended in: {err}")),
+        }
+        // roomler (#3755): on one thread no `pop` runs during a drop, so no
+        // large message begins while anything is owed.
+        let begun_owing = queue.began_while_owed();
+        if one_thread && begun_owing > 0 {
+            findings.push(format!(
+                "{begun_owing} large message(s) began while a cut one was owed, on one thread"
+            ));
+        }
+        link_up.store(false, Ordering::SeqCst);
+        if let Err(err) = link.await {
+            findings.push(format!("the link ended in: {err}"));
+        }
+        if !drains_within(&br, &a0, &a1, Duration::from_secs(10)).await {
+            findings.push("the association never drained".to_owned());
+        }
+
+        let mut buf = vec![0u8; 32 * 1024];
+        let mut read = Vec::new();
+        while let Some(r) = read_within(&s1, &mut buf, Duration::from_millis(500)).await {
+            let (n, _) = r?;
+            read.push(buf[..n].to_vec());
+        }
+        let log = log.lock().unwrap().clone();
+        // roomler (#3755): every write was logged, so none escaped the check.
+        let writes = usize::from(WRITERS) * WRITES as usize;
+        if log.len() != writes {
+            findings.push(format!(
+                "the writers logged {} of their {writes} writes",
+                log.len()
+            ));
+        }
+        findings.extend(check_cut_writes(&log, &read, one_thread));
+        let left = s0.buffered_amount();
+        if left != 0 {
+            findings.push(format!(
+                "the stream's buffered_amount is {left} once everything was acknowledged, not 0"
+            ));
+        }
+        findings.extend(queue_at_rest(&queue, SMALL_QUEUE));
+        Ok(())
+    }
+    .await;
+
+    close_association_pair(&br, a0, a1).await;
+    outcome?;
+    Ok(findings)
+}
+
+/// roomler (#3755) AC3: the class. Writers share one ordered stream, and each
+/// of their writes is either awaited to its end or cut at a seeded wait: for
+/// the stream's turn, for the queue's lock, for room for a small message, for
+/// room for the next chunk of a large one. The link moves all along. The peer
+/// must read only whole messages, each writer's in the order written, none
+/// twice, and every write that returned `Ok`, in the order they returned. A
+/// cut write is never read, or read whole and once, in its place.
+///
+/// No room is free while a cut message is owed, so no large message begins
+/// while one is: the overdraft is at most the rest of one message, under the
+/// largest a round writes.
+#[tokio::test(flavor = "current_thread")]
+async fn test_assoc_writes_cut_at_any_wait_keep_the_stream_whole() -> Result<()> {
+    let mut findings = Vec::new();
+    for seed in [0x3755_u64, 1, 2, 3] {
+        for finding in cut_writes_round(seed, true).await? {
+            findings.push(format!("seed {seed:#x}: {finding}"));
+        }
+    }
+    assert!(
+        findings.is_empty(),
+        "#3755 AC3, writes cut at any wait:\n  - {}",
+        findings.join("\n  - ")
+    );
+    Ok(())
+}
+
+/// The largest message an AC3 round writes, in bytes.
+const LARGEST_CUT_TEST_MESSAGE: usize = 5_500 + 14_500;
+
+/// roomler (#3755): AC3 on a runtime of two threads, where the write loop's
+/// `pop` runs on one thread while a cut write queues the rest of its message
+/// on the other. The same property, but for the order the writes returned in,
+/// which the writers can no longer log in the order they were queued; and the
+/// pending queue's accounting, at rest once drained. A `pop` that decides
+/// during a cut write's drop pays the debt the drop has already recorded; one
+/// that decided before can leave its chunk free while the rest is owed, and a
+/// large message that begins on it adds its own rest (`BegunMessage`). So the
+/// overdraft sampled while the writers run stays under (1 + those messages)
+/// times the largest message: one largest message when no `pop` raced a drop.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn test_assoc_writes_cut_on_two_threads_keep_the_queue_accounting() -> Result<()> {
+    let mut findings = Vec::new();
+    for seed in [0x3755_u64, 4, 5] {
+        for finding in cut_writes_round(seed, false).await? {
+            findings.push(format!("seed {seed:#x}: {finding}"));
+        }
+    }
+    assert!(
+        findings.is_empty(),
+        "#3755, writes cut on two threads:\n  - {}",
+        findings.join("\n  - ")
+    );
+    Ok(())
+}
+
+/// roomler (#4033): how long a lone packet's SACK may take, from its write.
+/// The receiver holds it one `ACK_INTERVAL` (200 ms), and the bridge's ticks
+/// and the scheduler add the rest: 277 to 296 ms on a Windows box, alone and
+/// in the whole suite, so this is 2.7 times the most (FR-148 D44). A lone
+/// packet whose ack timer was never armed is acknowledged only when the
+/// sender's T3-rtx retransmits it, at RTO.min (1 s) at the earliest, so a
+/// slow runner only takes that further over this.
+const LONE_PACKET_SACK_WITHIN: Duration = ACK_INTERVAL.saturating_add(Duration::from_millis(600));
+
+/// roomler (#4033): each lone packet is acknowledged within the delayed
+/// acknowledgement interval. `AckTimer::start` arms a timer only while the
+/// handle that `stop` empties is empty, and a timer that fired left it set, so
+/// after the first delayed acknowledgement the next lone packet armed none.
+/// Its SACK waited for another packet or for the sender's T3-rtx, which also
+/// cut the sender's congestion window to one packet (RFC 4960 §7.2.3). The
+/// session's first message is acknowledged by the timer; then two lone
+/// packets, each sent more than an interval after the last SACK, so that one
+/// of them meets a timer that fired however the one before it was
+/// acknowledged.
+#[tokio::test]
+async fn test_assoc_each_lone_packet_is_acknowledged_within_the_ack_interval() -> Result<()> {
+    const SI: u16 = 1;
+
+    let (br, ca, cb) = Bridge::new(0, None, None);
+    let (a0, mut a1) =
+        create_new_association_pair(&br, Arc::new(ca), Arc::new(cb), AckMode::Normal, 0).await?;
+
+    let mut findings: Vec<String> = Vec::new();
+    let outcome: Result<()> = async {
+        let (s0, _s1) = establish_session_pair(&br, &a0, &mut a1, SI).await?;
+        for i in 1..=2 {
+            tokio::time::sleep(ACK_INTERVAL + Duration::from_millis(100)).await;
+            let msg = Bytes::from(format!("lone packet {i}"));
+            let sent = tokio::time::Instant::now();
+            s0.write_sctp(&msg, PayloadProtocolIdentifier::Binary)
+                .await?;
+            while s0.buffered_amount() > 0 && sent.elapsed() < Duration::from_secs(5) {
+                br.tick().await;
+                tokio::time::sleep(Duration::from_millis(1)).await;
+            }
+            let took = sent.elapsed();
+            println!(
+                "#4033: lone packet {i} acknowledged in {} ms",
+                took.as_millis()
+            );
+            if s0.buffered_amount() > 0 {
+                findings.push(format!("lone packet {i} was not acknowledged within 5 s"));
+            } else if took > LONE_PACKET_SACK_WITHIN {
+                findings.push(format!(
+                    "lone packet {i} was acknowledged in {} ms, over {} ms",
+                    took.as_millis(),
+                    LONE_PACKET_SACK_WITHIN.as_millis()
+                ));
+            }
+        }
+        let t3 = a0
+            .association_internal
+            .lock()
+            .await
+            .stats
+            .get_num_t3timeouts();
+        if t3 > 0 {
+            findings.push(format!(
+                "the sender's T3-rtx expired {t3} time(s), retransmitting a lone packet \
+                 and cutting its congestion window to one packet"
+            ));
+        }
+        Ok(())
+    }
+    .await;
+
+    close_association_pair(&br, a0, a1).await;
+    outcome?;
+    assert!(
+        findings.is_empty(),
+        "#4033, a lone packet's SACK:\n  - {}",
+        findings.join("\n  - ")
+    );
+    Ok(())
+}
+
+/// roomler (FR-148 P0, D43): the pacer in the association's own write loop.
+/// The other pacer tests call the send path directly; this one runs the write
+/// loop, whose wait wakes when the chunk the pacer held may leave
+/// (`pacer::until`). The pacer takes its round trip from the SACK of a message
+/// the bridge holds for 150 ms, so it lets out the congestion window of 4,380
+/// bytes over 150 ms or more: a chunk of 1,200 bytes takes 41 ms or more of
+/// its tokens. Then four messages are written at once and the bridge delivers
+/// nothing more, so no SACK comes and nothing else is written: only the
+/// pacer's own wake can let out the second and the third, and the window holds
+/// the fourth. T3-rtx would send again only at RTO.min, 1 s.
+#[tokio::test]
+async fn test_assoc_pacer_the_write_loop_wakes_for_the_chunk_it_held() -> Result<()> {
+    const SI: u16 = 1;
+    const HELD: Duration = Duration::from_millis(150);
+    const WITHIN: Duration = Duration::from_millis(700);
+
+    let (br, ca, cb) = Bridge::new(0, None, None);
+    let (a0, mut a1) =
+        create_new_association_pair(&br, Arc::new(ca), Arc::new(cb), AckMode::NoDelay, 0).await?;
+
+    let outcome: Result<(usize, Duration)> = async {
+        let (s0, _s1) = establish_session_pair(&br, &a0, &mut a1, SI).await?;
+        let message = Bytes::from(vec![0u8; 1200]);
+        a0.pacer().set(true);
+        s0.write_sctp(&message, PayloadProtocolIdentifier::Binary)
+            .await?;
+        tokio::time::sleep(HELD).await;
+        flush_buffers(&br, &a0, &a1).await;
+
+        for _ in 0..4 {
+            s0.write_sctp(&message, PayloadProtocolIdentifier::Binary)
+                .await?;
+        }
+        let written = tokio::time::Instant::now();
+        while br.len(0).await < 3 && written.elapsed() < WITHIN {
+            tokio::time::sleep(Duration::from_millis(5)).await;
+        }
+        Ok((br.len(0).await, written.elapsed()))
+    }
+    .await;
+
+    close_association_pair(&br, a0, a1).await;
+    let (sent, took) = outcome?;
+    println!(
+        "FR-148 D43: {sent} of 4 chunks sent in {} ms, with no SACK",
+        took.as_millis()
+    );
+    assert!(
+        sent >= 3,
+        "the write loop let out {sent} chunk(s) in {} ms with no SACK: it never woke for the \
+         chunk the pacer held",
+        took.as_millis()
+    );
+    Ok(())
+}
diff -ruN --strip-trailing-cr upstream/src/association/delivery.rs vendored/src/association/delivery.rs
--- upstream/src/association/delivery.rs	1970-01-01 01:00:00.000000000 +0100
+++ vendored/src/association/delivery.rs	2026-11-27 10:38:52.257458800 +0100
@@ -0,0 +1,118 @@
+//! roomler (FR-148 P0): the association's acknowledgement clock, counted where
+//! it happens and read without the association's lock.
+//!
+//! Two things are counted. The bytes the peer acknowledged it received, in the
+//! SACK handler, over every stream: that is the clock a delivery rate is read from,
+//! not the write call, which returns once SCTP has queued the bytes. And the
+//! moments the queue of written, not yet sent chunks fills and runs empty, in
+//! the pending queue: a reader learns from them whether the sender had more
+//! to send than the path took for a whole interval, or ran out.
+
+use std::sync::atomic::Ordering;
+use std::sync::Arc;
+
+use portable_atomic::AtomicU64;
+
+/// The counters, kept by the pending queue (fills and empties) and by the
+/// SACK handler (acknowledged bytes, and the loss mark that decides them).
+#[derive(Debug, Default)]
+pub(crate) struct DeliveryCounters {
+    acked_bytes: AtomicU64,
+    queue_fills: AtomicU64,
+    queue_empties: AtomicU64,
+    /// [`Self::loss_mark`], plus one; 0 is none.
+    loss_mark: AtomicU64,
+}
+
+impl DeliveryCounters {
+    /// `n` bytes of user data that one SACK newly acknowledged the peer
+    /// received, by its cumulative point and its gap blocks, over every
+    /// stream.
+    pub(crate) fn on_acked(&self, n: u64) {
+        self.acked_bytes.fetch_add(n, Ordering::SeqCst);
+    }
+
+    /// The SACK handler's evidence of loss: every chunk still outstanding
+    /// below this TSN was reported missing by a SACK (a gap block above it)
+    /// or was outstanding when T3-rtx expired. An abandoned chunk below it
+    /// that the cumulative point passes is not counted: a FORWARD TSN may
+    /// have skipped it. Kept by the association under its lock; no reader
+    /// of the clock sees it.
+    pub(crate) fn loss_mark(&self) -> Option<u32> {
+        match self.loss_mark.load(Ordering::SeqCst) {
+            0 => None,
+            m => u32::try_from(m - 1).ok(),
+        }
+    }
+
+    pub(crate) fn set_loss_mark(&self, mark: Option<u32>) {
+        let m = mark.map_or(0, |m| u64::from(m) + 1);
+        self.loss_mark.store(m, Ordering::SeqCst);
+    }
+
+    /// The pending queue went from empty to holding bytes.
+    pub(crate) fn on_queue_filled(&self) {
+        self.queue_fills.fetch_add(1, Ordering::SeqCst);
+    }
+
+    /// The pending queue went from holding bytes to empty.
+    pub(crate) fn on_queue_emptied(&self) {
+        self.queue_empties.fetch_add(1, Ordering::SeqCst);
+    }
+}
+
+/// One reading of an association's delivery counters. Every field counts from
+/// the association's start, so two readings give an interval.
+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]
+pub struct Delivery {
+    /// Bytes of user data the peer acknowledged it received, each chunk once,
+    /// over every stream: by a gap block, or by the cumulative point. A chunk
+    /// abandoned under partial reliability that a SACK reported missing, or
+    /// that was outstanding when T3-rtx expired, is left out when the
+    /// cumulative point passes it, as a FORWARD TSN may have skipped it. One
+    /// lost with no such evidence still counts: SCTP does not tell a sender
+    /// which skipped chunks arrived.
+    pub acked_bytes: u64,
+    /// Times the queue of written, not yet sent chunks went from empty to not.
+    pub queue_fills: u64,
+    /// Times it went from not empty to empty.
+    pub queue_empties: u64,
+}
+
+impl Delivery {
+    /// Whether the queue of written, not yet sent chunks was empty when this
+    /// was read. A transition racing the read shows a moment late.
+    pub fn queue_empty(&self) -> bool {
+        self.queue_fills <= self.queue_empties
+    }
+}
+
+/// A handle onto one association's [`Delivery`] counters. It keeps the
+/// counters alive, and nothing else of the association.
+#[derive(Debug, Clone)]
+pub struct DeliveryClock(Arc<DeliveryCounters>);
+
+impl DeliveryClock {
+    pub(crate) fn new(counters: Arc<DeliveryCounters>) -> Self {
+        Self(counters)
+    }
+
+    /// The counters now. Lock-free: three loads.
+    pub fn read(&self) -> Delivery {
+        // Empties before fills: a fill and an empty racing the two loads then
+        // read as not empty, which is what the queue was a moment later.
+        let queue_empties = self.0.queue_empties.load(Ordering::SeqCst);
+        let queue_fills = self.0.queue_fills.load(Ordering::SeqCst);
+        let acked_bytes = self.0.acked_bytes.load(Ordering::SeqCst);
+        Delivery {
+            acked_bytes,
+            queue_fills,
+            queue_empties,
+        }
+    }
+
+    /// Whether `self` and `other` read the same association.
+    pub fn same(&self, other: &DeliveryClock) -> bool {
+        Arc::ptr_eq(&self.0, &other.0)
+    }
+}
