+/// check OS-independent and immune to adapter renames.
+pub(crate) fn is_roomler_overlay_ip(ip: &std::net::IpAddr) -> bool {
+    match ip {
+        std::net::IpAddr::V4(v4) => {
+            let o = v4.octets();
