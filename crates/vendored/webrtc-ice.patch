+            scheme: SchemeType::Turn,
+            host: "127.0.0.1".to_owned(),
+            username: "username".to_owned(),
+            password: "password".to_owned(),
+            port: server_port,
+            proto: ProtoType::Udp,
+        }],
+        candidate_types: vec![CandidateType::Relay],
+        ..Default::default()
+    })
+    .await?;
