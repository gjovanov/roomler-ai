+pub(crate) fn host_priority(rank: Option<&CarrierRank>, ip: &std::net::IpAddr, component: u16) -> u32 {
+    match rank {
+        Some(rank) if rank.ranks_last(*ip) => ranked_last_priority(component),
+        _ => overlay_host_priority_override(ip, component),
+    }
