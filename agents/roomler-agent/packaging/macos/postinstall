#!/bin/bash
#
# pkg postinstall — runs as root after the payload is copied to
# /Library/Roomler/roomler-agent.app. We drop the LaunchAgent plist into the
# current console user's ~/Library/LaunchAgents/ and launchctl bootstrap it
# into their gui/<uid> domain so the agent starts immediately.
#
# We avoid `sudo -u` here because Apple's installer sanitises the env; we
# resolve the console user via stat on /dev/console which is the reliable
# idiom on macOS installers.

set -euo pipefail

CONSOLE_USER=$(stat -f "%Su" /dev/console)

# Sweep the pre-rc.457 location. The daemon bundle used to live in
# /Applications, where it showed up in Finder and Launchpad as a second Roomler
# icon that does nothing when double-clicked. A pkg install is ADDITIVE, so an
# upgrade would leave that copy sitting there forever — still visible, now also
# stale, and running nothing (both plists point at the new path).
if [ -d /Applications/roomler-agent.app ]; then
  rm -rf /Applications/roomler-agent.app
  echo "removed the old /Applications/roomler-agent.app (the daemon now lives in /Library/Roomler)"
fi

# No GUI session — installed over SSH, at the login window, or on a runner.
# There is no `gui/<uid>` domain to bootstrap into, and `root` has no Aqua
# domain either.
#
# This must NOT fail the install. The payload is already on disk by the time
# scripts run, so aborting here leaves a HALF-APPLIED install reported as a
# failure ("An error occurred while running scripts") with nothing saying why —
# which is what `set -euo pipefail` plus an unguarded `bootstrap` used to do.
# The plist cannot be placed without a home directory to place it in, so the
# honest outcome is: payload installed, autostart deferred to the next login,
# said plainly.
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = root ]; then
  echo "roomler-agent: payload installed, but NO GUI session is logged in"
  echo "  (console user is '${CONSOLE_USER:-unknown}'), so the LaunchAgent was"
  echo "  not registered. Log in on this Mac and re-run the installer, or:"
  echo "    sudo installer -pkg <the .pkg> -target /"
  echo "  Screen capture and input need a login session and cannot run without one."
  exit 0
fi

CONSOLE_UID=$(id -u "$CONSOLE_USER")
CONSOLE_HOME=$(dscl . -read /Users/"$CONSOLE_USER" NFSHomeDirectory | awk '{print $2}')

LAUNCH_AGENTS_DIR="$CONSOLE_HOME/Library/LaunchAgents"
PLIST_SOURCE="/Library/Roomler/roomler-agent.app/Contents/Resources/com.roomler.agent.plist"
PLIST_TARGET="$LAUNCH_AGENTS_DIR/com.roomler.agent.plist"

mkdir -p "$LAUNCH_AGENTS_DIR"
cp "$PLIST_SOURCE" "$PLIST_TARGET"
chown "$CONSOLE_USER":staff "$PLIST_TARGET"
chmod 644 "$PLIST_TARGET"

# Load the agent into the user's launchd domain. `bootstrap` is idempotent
# only if the agent isn't already loaded; we unload first to handle upgrades.
#
# A failure here is reported, not fatal: the plist is in ~/Library/LaunchAgents,
# so launchd starts it at the next login regardless. Trading a working install
# for a launchctl edge case (a session that exists but will not accept a
# bootstrap) is the wrong way round.
launchctl bootout "gui/$CONSOLE_UID/com.roomler.agent" 2>/dev/null || true
if launchctl bootstrap "gui/$CONSOLE_UID" "$PLIST_TARGET" 2>/tmp/roomler-bootstrap.err; then
  echo "roomler-agent installed and started for $CONSOLE_USER (uid=$CONSOLE_UID)"
else
  echo "roomler-agent installed for $CONSOLE_USER (uid=$CONSOLE_UID), but launchctl"
  echo "  bootstrap failed: $(cat /tmp/roomler-bootstrap.err 2>/dev/null)"
  echo "  The plist is in place, so it will start at the next login."
fi
rm -f /tmp/roomler-bootstrap.err

# The desktop companion (menu-bar app), same user domain. It is a UI surface,
# not a service: it holds no session and captures nothing, so a failure to
# start it must never fail the install — but it IS the only place that tells
# the user which macOS permission is missing, which the OS never does.
DESKTOP_PLIST_SOURCE="/Library/Roomler/roomler-agent.app/Contents/Resources/com.roomler.desktop.plist"
DESKTOP_PLIST_TARGET="$LAUNCH_AGENTS_DIR/com.roomler.desktop.plist"
if [ -f "$DESKTOP_PLIST_SOURCE" ] && [ -d /Applications/Roomler.app ]; then
  cp "$DESKTOP_PLIST_SOURCE" "$DESKTOP_PLIST_TARGET"
  chown "$CONSOLE_USER":staff "$DESKTOP_PLIST_TARGET"
  chmod 644 "$DESKTOP_PLIST_TARGET"
  launchctl bootout "gui/$CONSOLE_UID/com.roomler.desktop" 2>/dev/null || true
  if launchctl bootstrap "gui/$CONSOLE_UID" "$DESKTOP_PLIST_TARGET" 2>/dev/null; then
    echo "Roomler menu-bar app started for $CONSOLE_USER"
  else
    echo "Roomler menu-bar app installed; it will start at the next login"
  fi
else
  echo "NOTE: the menu-bar companion is not in this package; skipping"
fi

echo "Grant Screen Recording + Accessibility permissions in System Settings, then:"
echo "  launchctl kickstart -k gui/$CONSOLE_UID/com.roomler.agent"
echo "(the Roomler menu-bar app shows which of the two is missing, with a button for each)"

# ---------------------------------------------------------------------------
# The privileged half — OPT-IN.
#
# The LaunchAgent above is unprivileged by necessity: capture and input need
# the GUI session. But creating a utun and installing routes need root, which
# is why the overlay has never come up on a real macOS install. A root
# LaunchDaemon closes that, and it is deliberately NOT installed by default:
# putting a root daemon on someone's Mac is a posture decision, not a side
# effect of installing a remote-control agent.
#
# Enable with either:
#   sudo mkdir -p /etc/roomler-agent && sudo touch /etc/roomler-agent/enable-daemon
#   (then re-run the installer), or
#   ROOMLER_MACOS_DAEMON=1 installer -pkg … -target /
#
# The daemon gets its OWN config at /etc/roomler-agent/config.toml. It must
# not share the user's: two processes on one enrollment identity would fight
# over the control WS (the hub keys on agent_id — the second connection
# displaces the first), so they are separate enrollments by construction.
# ---------------------------------------------------------------------------
DAEMON_PLIST_SOURCE="/Library/Roomler/roomler-agent.app/Contents/Resources/com.roomler.daemon.plist"
DAEMON_PLIST_TARGET="/Library/LaunchDaemons/com.roomler.daemon.plist"

if [ -f /etc/roomler-agent/enable-daemon ] || [ "${ROOMLER_MACOS_DAEMON:-0}" = "1" ]; then
  if [ ! -f "$DAEMON_PLIST_SOURCE" ]; then
    echo "WARNING: daemon requested but $DAEMON_PLIST_SOURCE is missing; skipping"
  else
    mkdir -p /etc/roomler-agent /var/log/roomler-agent
    cp "$DAEMON_PLIST_SOURCE" "$DAEMON_PLIST_TARGET"
    chown root:wheel "$DAEMON_PLIST_TARGET"
    chmod 644 "$DAEMON_PLIST_TARGET"

    # bootout first so an upgrade replaces a running job rather than failing
    # the (non-idempotent) bootstrap.
    launchctl bootout system/com.roomler.daemon 2>/dev/null || true
    launchctl bootstrap system "$DAEMON_PLIST_TARGET"

    echo "roomler system daemon installed (overlay/tunnel run as root)."
    if [ ! -f /etc/roomler-agent/config.toml ]; then
      echo "  NOT ENROLLED YET — the daemon needs its own enrollment:"
      echo "    sudo /Library/Roomler/roomler-agent.app/Contents/MacOS/roomler-agent \\"
      echo "      --config /etc/roomler-agent/config.toml \\"
      echo "      enroll --server <url> --token <enrollment-jwt> --name <label>"
      echo "    sudo launchctl kickstart -k system/com.roomler.daemon"
    fi
    echo "  Its LocalAPI lives at /var/run/roomler/roomler.sock — reach it with"
    echo "  'sudo roomler …' (an unprivileged 'roomler' finds the user agent)."
  fi
else
  # A previously-enabled daemon must go away when the marker does, or an
  # upgrade would silently keep a root job the operator has opted out of.
  if [ -f "$DAEMON_PLIST_TARGET" ]; then
    launchctl bootout system/com.roomler.daemon 2>/dev/null || true
    rm -f "$DAEMON_PLIST_TARGET"
    echo "roomler system daemon disabled (no /etc/roomler-agent/enable-daemon)."
  fi
fi

exit 0
