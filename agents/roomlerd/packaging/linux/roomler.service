[Unit]
Description=Roomler Daemon — keeps this device on your private Roomler mesh network and available for secure remote control
Documentation=https://roomler.ai/
# An interactive user session is required for scrap capture (XShm needs a
# display) and enigo input injection (both run on the user's X server).
# This is a systemd *user* unit, not a system unit, for that reason.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# RETIRED-NAME-ANCHOR(3): a "was X" line has to name X.
# P3d Slice B: the daemon binary is now `roomlerd` (was `roomler-agent`).
ExecStart=/usr/bin/roomlerd run
# `always`, not `on-failure`: a self-update exits 0 on purpose (the agent
# hands off to the installer and shuts down cleanly), and `on-failure`
# would leave the node stopped until the next login — a successful
# upgrade would read as the host going offline. Codes come from
# `watchdog.rs`: 2 = STALL (watchdog forced exit) MUST come back;
# 7 = AGENT_DELETED (row deleted / quarantined server-side) must NOT —
# restarting only hammers a server that already said no; 8 = ALREADY_RUNNING
# (another process holds the single-instance lock) must NOT either — this
# process is redundant by definition, and without the exception `always`
# restarts it every 5 s forever. Especially reachable for THIS unit: a
# per-user agent and the system `roomlerd.service` both target the same
# config on a desktop that enabled both.
Restart=always
RestartSec=5
RestartPreventExitStatus=7 8
# RETIRED-NAME-ANCHOR: `roomler_agent` is the pre-FR-21 tracing target. Kept
# alongside the new one so this unit reads correctly on a daemon from either
# side of the rename; agent-core::logging mirrors it for units already on disk.
Environment=RUST_LOG=roomlerd=info,warn

# Sandboxing — conservative defaults appropriate for a user unit.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# RETIRED-NAME-ANCHOR(10): systemd must whitelist BOTH trees or it denies an upgraded
# host its own.
# P3d Slice B: the appdirs resolver (src/appdirs.rs) uses the NEW `roomler`
# app segment on fresh installs but keeps the OLD `roomler-agent` tree when a
# pre-rename host already has one. Whitelist BOTH so neither a fresh install
# nor an upgraded host is blocked by ProtectHome=read-only.
# RETIRED-NAME-ANCHOR: dropping the legacy pair makes systemd deny the daemon its own
# pre-rename tree mid-migration, under ProtectHome=read-only. See docs/fr/FR-21.
# ⚠️ The legacy pair carries `-` ("ignore when missing"): a path listed WITHOUT
# it that does not exist fails the whole unit with 226/NAMESPACE ("Failed to
# set up mount namespacing: <the legacy config folder>: No such file or
# directory") — measured on systemd 255 — and a host that never ran the
# pre-rename agent has neither folder, so the unit could not start there at
# all WHEREVER THE SANDBOX APPLIES. A user manager applies it only if it can
# create an unprivileged user namespace; where it cannot (e.g. Ubuntu 24.04's
# default AppArmor restriction) systemd logs "Failed to set up user
# namespacing for unprivileged user, ignoring" and runs this unit with NO
# sandbox at all, which is why such a host started fine. The NEW pair keeps
# no prefix on purpose: `roomlerd enroll` creates both (the config, and the
# log folder), and a unit started before enrolling should fail naming the
# missing folder rather than run with it read-only.
ReadWritePaths=%h/.config/roomler %h/.local/share/roomler -%h/.config/roomler-agent -%h/.local/share/roomler-agent
# FR-85 P2c — the recorder's default folder (`~/Videos/Roomler`). Everything
# else under home stays read-only: a folder chosen elsewhere is refused by the
# recorder's test write, which falls back and names why in the Recordings
# view. `-`: a host without ~/Videos must still start (see above). A
# localized Videos folder (XDG_VIDEOS_DIR=~/Vidéos, …) is not covered and
# falls back the same way.
ReadWritePaths=-%h/Videos

[Install]
WantedBy=default.target
