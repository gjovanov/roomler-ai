<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchDAEMON for roomlerd — the privileged half.

  Why this exists: creating a utun and installing routes require root, and
  the agent has only ever shipped as a per-user LaunchAgent. So on macOS the
  overlay could never come up on a real install, no matter what the code did
  — the daemon simply lacked the privilege. `com.roomler.agent.plist` (the
  LaunchAgent) stays exactly as it is, because capture (ScreenCaptureKit /
  CoreGraphics) and input (CGEvent) need the GUI session and do NOT work
  from session 0. The two halves are complementary, not alternatives.

  Installed to /Library/LaunchDaemons/ by the .pkg postinstall and
  bootstrapped into the `system` domain, so it runs at boot with no user
  logged in.

  Opt-in: the postinstall only loads this when the operator asks for it
  (`/etc/roomler/enable-daemon` present — the marker is the ONLY
  channel; PackageKit scripts inherit no environment, which is why the old
  ROOMLER_MACOS_DAEMON=1 form never worked and was removed). A root daemon
  on someone's Mac is a posture decision, not a side effect of installing a
  remote-control agent.

  `--config` is explicit: a root daemon and a user agent must NOT share the
  per-user config path, or they would fight over one enrollment identity —
  the hub keys on agent_id and the second connection displaces the first.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.roomler.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Roomler/roomlerd.app/Contents/MacOS/roomlerd</string>
        <string>--config</string>
        <string>/etc/roomler/config.toml</string>
        <string>run</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Restart backoff: a crash-looping daemon must not spin the machine. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- FR-119 P2b-9: Interactive, like the LaunchAgent and the desktop job.
         Without a ProcessType, launchd applies "light resource limits" and
         throttles the job's CPU and I/O. Since FR-43 the worker that runs
         every session (capture, encode, send) is spawned INSIDE this job, so
         it inherits them. Measured on a MacBook (2026-10-24): every thread of
         the daemon and the worker scheduled at priority 20, the utility band,
         under WindowServer (79) and the apps (47). At 120 fps a frame was
         taken late a third of the time: hand-off p99 17.5 ms, 113 fps. With
         this key both halves ran at 37 and the cadence went flat (p99
         10.65 ms, 119 fps). A session pipeline is the person's experience, not
         background work. -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <!-- FR-97 P6e (#1538): stdout carries only tracing's console copy of the
         rotating log, and here it grew unrotated (42 MB on one Mac). stderr
         keeps the file, for the lines a daemon prints before its log exists. -->
    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>/var/log/roomler/daemon.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>RUST_LOG</key>
        <string>info</string>
    </dict>
</dict>
</plist>
