<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- RETIRED-NAME-ANCHOR-BEGIN
     Frozen macOS layout (FR-21 D5). The .app bundle name keys this host's
     Screen Recording and Accessibility TCC grants, and the log and config
     paths below are pinned to it by launchd. A rename voids the grants
     silently: the daemon runs and captures a black screen. -->
<!--
  LaunchAgent for roomlerd. Installed to ~/Library/LaunchAgents/ by
  the .pkg's post-install script. Runs in the user's session (required for
  ScreenCaptureKit / CoreGraphics capture and for CGEvent input injection;
  neither works in a LaunchDaemon running as _root in session 0).

  First run will trigger two permission prompts:
   - Screen Recording (System Settings -> Privacy & Security)
   - Accessibility       (System Settings -> Privacy & Security)
  Grant both, then `launchctl kickstart -k gui/$UID/com.roomler.agent`.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.roomler.agent</string>

    <key>ProgramArguments</key>
    <array>
    <!-- RETIRED-NAME-ANCHOR: the .app bundle name KEYS THE macOS TCC GRANTS; renaming
         it silently drops Screen Recording + Accessibility on every Mac. FR-21 D5
         freezes it. docs/fr/FR-21 -->
        <string>/Library/Roomler/roomlerd.app/Contents/MacOS/roomlerd</string>
        <string>run</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/tmp/roomlerd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/roomlerd.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>RUST_LOG</key>
        <!-- RETIRED-NAME-ANCHOR: pre-FR-21 tracing target, kept beside the new one. -->
        <string>roomler_agent=info,roomlerd=info,warn</string>
    </dict>
</dict>
  <!-- RETIRED-NAME-ANCHOR-END -->
</plist>
