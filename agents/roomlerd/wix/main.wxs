<?xml version="1.0" encoding="windows-1252"?>
<!-- RETIRED-NAME-ANCHOR-BEGIN
     Every retired name here is MSI identity or legacy cleanup: the
     roomler_agent_exe FileKey that upgrades key off,
     the inert roomler-agent.exe alias the deployed fleet still resolves, and the
     pre-P4b install folder this package vacates.
     INVARIANT: an MSI identifier that ships cannot be renamed without breaking
     upgrades from every installed version. docs/fr/FR-21
-->
<!--
  WiX v3 source for roomler-agent MSI.

  Build with `cargo wix -p roomlerd` which invokes candle + light
  against this file.

  Install scope: per-user (InstallScope="perUser"). No UAC prompt and no
  admin rights required. Files land under
  %LOCALAPPDATA%\Programs\Roomler\ (P4b renamed the folder from
  roomler-agent; the cleanup-legacy-install CA sweeps the vacated dir on
  upgrade) and config / state stays under %APPDATA%\roomler-agent\
  (written by the `directories` crate at runtime — deliberately NOT
  renamed: machine_id derives from the config path).

  Autostart: registered automatically on every install + upgrade via the
  RegisterAutostart custom action below. The action shells out to
  `roomlerd service install` which writes a Schema 1.2 Task
  Scheduler XML with battery-defeat settings and, on an enrolled machine,
  a start shortly after (see
  agents/roomlerd/src/service.rs::render_task_xml). Symmetric
  UnregisterAutostart hook runs `service uninstall` before the EXE is
  removed during uninstall. Both actions Return="ignore" so an
  individual machine where the existing task has a tightened ACL (rare
  Win11 quirk that bit us 2026-04-29) doesn't sink the whole MSI —
  operator can still recover via the manual schtasks delete + service
  install path documented in packaging/windows/README.txt.

  roomlerdw.exe (#3292): the windowless launcher. The task, the custom
  actions and the Start menu entry all run through it, because Windows opens
  a terminal for any console program started from one of those, on the
  person's desktop, in the foreground. It starts its sibling roomlerd.exe with
  the arguments it was given and leaves with its exit code. Each custom action's
  FileKey is therefore the launcher's. A MajorUpgrade runs the OLD product's
  UnregisterAutostart from the OLD MSI's table, so the jump from a release
  before the launcher can still flash one terminal.

  Why this works without UAC: perUser MSIs run in the user's token
  context. Custom actions with Execute="deferred" Impersonate="yes"
  (which is the default in perUser mode) inherit that token. schtasks
  /Create /XML /F against a non-elevated task succeeds for the user
  who owns it.

  Effort 2 note (Windows Service deployment mode, 0.1.58):
  This MSI does NOT auto-register the alternative SCM service.
  CreateService requires admin elevation, which conflicts with the
  perUser install scope. Operators who want the service-mode autostart
  (fleet / pre-logon scenarios) install the MSI normally, then run
  `roomlerd service install` with the `as-service` flag from an
  elevated shell. A future per-machine MSI flavour can revisit
  auto-registering the SCM service via a deferred non-impersonated
  custom action.
  (XML comment rule: no consecutive dashes, hence the awkward phrasing.)
-->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <!-- FR-133 P1: Name is what Apps & Features lists, and it is a DISPLAY name
         only. Windows Installer matches an upgrade by the UpgradeCode (the
         MajorUpgrade below), and roomlerd's install_detect keys on that too, so
         the rename leaves upgrades alone: a machine installed before P1 keeps its
         old entry until the next upgrade replaces it, and scripts/install.ps1
         finds either name. The UpgradeCode, the Component and Feature Ids and
         the FileKeys are installer IDENTITY and never change. -->
    <Product
        Id='*'
        Name='Roomler'
        UpgradeCode='1F2D7B1C-8B2F-4D2E-B1A3-6B1E2C7E4D91'
        Manufacturer='G ROX LTD'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package
            Id='*'
            Keywords='Installer'
            Description='Roomler Daemon — private mesh network + secure remote control'
            Manufacturer='G ROX LTD'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perUser'
            SummaryCodepage='1252' />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.' />

        <!--
          rc.18: dropped the cross-flavour LaunchCondition refusal that
          previously blocked install over the OTHER flavour. The
          CleanupLegacyPerMachine custom action below now scrubs any
          stale perMachine artefacts (SCM service + service-log dir)
          before InstallFiles runs, so the operator can switch flavours
          freely.
        -->

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' />
        <Property Id='DiskPrompt' Value='Roomler Installation' />

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <!-- Per-user install under %LOCALAPPDATA%\Programs\Roomler
                 (P4b: renamed from roomler-agent — the node-stack
                 unification's ONE install folder; UpgradeCode unchanged, so
                 MajorUpgrade still removes the old-folder product first).
                 ICE38 requires components in a user-profile directory to use
                 an HKCU registry value as their KeyPath (not a file). ICE64
                 requires a RemoveFolder entry for every user-profile dir. -->
            <Directory Id='LocalAppDataFolder'>
                <Directory Id='ProgramsFolder' Name='Programs'>
                    <Directory Id='APPLICATIONFOLDER' Name='Roomler'>
                        <Component Id='AgentExe' Guid='3A8C9F21-4E7D-4A8E-9F3B-8D1C2E7F5A62'>
                            <RegistryValue
                                Root='HKCU'
                                Key='Software\Roomler\Agent'
                                Name='installed_exe'
                                Type='integer'
                                Value='1'
                                KeyPath='yes' />
                            <!-- P3d Slice B: the daemon EXE is now `roomlerd.exe`.
                                 The File Id stays `roomler_agent_exe`, and the
                                 component Id + Guid are unchanged, for stable
                                 component identity across upgrade. The custom actions
                                 below run through the launcher, which starts THIS
                                 (the real daemon) file. -->
                            <!-- RETIRED-NAME-ANCHOR(3): an MSI FileKey is installer IDENTITY, and
                                 upgrades key off it, so it is frozen deliberately, though #3292 moved
                                 this flavour's CustomActions to the launcher's. docs/fr/FR-21 -->
                            <File
                                Id='roomler_agent_exe'
                                Name='roomlerd.exe'
                                DiskId='1'
                                Source='target\release\roomlerd.exe' />
                            <RemoveFolder
                                Id='RemoveAppFolder'
                                Directory='APPLICATIONFOLDER'
                                On='uninstall' />
                            <RemoveFolder
                                Id='RemoveProgramsFolder'
                                Directory='ProgramsFolder'
                                On='uninstall' />
                        </Component>
                        <!-- P3d Slice C (retired Slice B's alias): the inert
                             `roomler-agent.exe` copy (`AgentExeAlias`, GUID
                             568CA8FA…) is no longer shipped — the whole live
                             fleet crossed rc.194 (verified against prod agents
                             2026-07-22), and every in-tree consumer resolves
                             `roomlerd.exe` first with a code-level fallback
                             (tray `agent_exe_path`). MajorUpgrade removes the
                             stale alias file from upgraded installs. -->
                        <!-- P4b: the tunnel CLI ships INSIDE the daemon MSI
                             (node-stack unification Option A — the MSI is the
                             one updater for the whole stack; daemon installs
                             subsume the CLI). Same component also appends the
                             install dir to the USER PATH so `roomler` works
                             in any new shell — parity with the standalone
                             tunnel wizard's PATH integration. PATH lives and
                             dies with the CLI file; Part='last' + implicit
                             Permanent='no' removes only our segment on
                             uninstall, and msiexec broadcasts
                             WM_SETTINGCHANGE itself. P3e lever D: the file is
                             now the ~150 KB roomler-cli-shim, which re-execs
                             `roomlerd cli` — the daemon owns the command
                             surface, so this MSI no longer carries a second
                             22.1 MiB copy of crates roomlerd already links.
                             Installed NAME is unchanged (roomler.exe), so the
                             PATH entry, user muscle memory and the
                             installer-smoke payload asserts all still hold.
                             The workflow builds
                             target\release\roomler-shim.exe via
                             `cargo build -p roomler-cli-shim [dash][dash]release`
                             before cargo-wix runs. HKCU KeyPath like siblings
                             (ICE38, user-profile dir). -->
                        <Component Id='TunnelExe' Guid='17E45A00-7EB6-44E0-97DB-2A6DB2D79683'>
                            <RegistryValue
                                Root='HKCU'
                                Key='Software\Roomler\Agent'
                                Name='installed_tunnel_cli'
                                Type='integer'
                                Value='1'
                                KeyPath='yes' />
                            <!-- RETIRED-NAME-ANCHOR(3): roomler_tunnel_cli_exe is installer IDENTITY;
                                 upgrades key off the FileKey, so it is frozen deliberately even though
                                 the crate is `roomler-cli` now. docs/fr/FR-21 -->
                            <File
                                Id='roomler_tunnel_cli_exe'
                                Name='roomler.exe'
                                DiskId='1'
                                Source='target\release\roomler-shim.exe' />
                            <Environment
                                Id='TunnelPathEnvPerUser'
                                Name='PATH'
                                Value='[APPLICATIONFOLDER]'
                                Part='last'
                                Action='set'
                                System='no' />
                        </Component>
                        <!-- #3292: what the per-user Scheduled Task, the custom
                             actions and the Start menu entry run, so that no
                             terminal opens on the person's desktop. The workflow
                             builds target\release\roomlerdw.exe via
                             `cargo build -p roomlerdw [dash][dash]release` and signs
                             it with the rest of the payload. Per-user only: the
                             service's supervisor starts its worker windowless by
                             itself. HKCU KeyPath like siblings (ICE38,
                             user-profile dir). -->
                        <Component Id='LauncherExe' Guid='5EB7791A-B52B-4E33-ADE3-2026B3AAA188'>
                            <RegistryValue
                                Root='HKCU'
                                Key='Software\Roomler\Agent'
                                Name='installed_launcher'
                                Type='integer'
                                Value='1'
                                KeyPath='yes' />
                            <File
                                Id='roomlerdw_exe'
                                Name='roomlerdw.exe'
                                DiskId='1'
                                Source='target\release\roomlerdw.exe' />
                        </Component>
                        <Component Id='LicenseTxt' Guid='4B1D2E80-6F3C-4B2A-9E1D-7A2B3C4D5E6F'>
                            <RegistryValue
                                Root='HKCU'
                                Key='Software\Roomler\Agent'
                                Name='installed_license'
                                Type='integer'
                                Value='1'
                                KeyPath='yes' />
                            <File
                                Id='license_txt'
                                Name='LICENSE.txt'
                                DiskId='1'
                                Source='LICENSE' />
                        </Component>
                        <Component Id='ReadmeTxt' Guid='5C2E3F91-7A4D-4C3B-AF2E-8B3C4D5E6F70'>
                            <RegistryValue
                                Root='HKCU'
                                Key='Software\Roomler\Agent'
                                Name='installed_readme'
                                Type='integer'
                                Value='1'
                                KeyPath='yes' />
                            <File
                                Id='readme_txt'
                                Name='README.txt'
                                DiskId='1'
                                Source='agents\roomlerd\packaging\windows\README.txt' />
                        </Component>
                        <!-- Phase 3b: Wintun TUN driver DLL for the overlay-l3
                             WireGuard mesh. LoadLibrary'd at runtime from the
                             app dir; signed by WireGuard LLC; staged into
                             target\release by the workflow's wintun step (only
                             overlay-l3 builds have it — the release pipeline
                             does). HKCU registry KeyPath like the siblings. -->
                        <Component Id='WintunDll' Guid='7E4A5B13-9C6F-4D5E-BF21-9D8E7F6A5B40'>
                            <RegistryValue
                                Root='HKCU'
                                Key='Software\Roomler\Agent'
                                Name='installed_wintun'
                                Type='integer'
                                Value='1'
                                KeyPath='yes' />
                            <File
                                Id='wintun_dll'
                                Name='wintun.dll'
                                DiskId='1'
                                Source='target\release\wintun.dll' />
                        </Component>
                        <!-- App-local Microsoft VC++ 2015-2022 x64 runtime
                             (only the DLLs our binaries actually import; the
                             full Microsoft.VC14x.CRT folder shipped through
                             rc.363 and carried 1.12 MiB of dead weight). The
                             import tables say msvcp140 + vcruntime140 +
                             vcruntime140_1 and nothing else: roomlerd.exe
                             imports all three, roomler.exe imports
                             vcruntime140, roomler-desktop.exe imports no CRT
                             at all, and msvcp140.dll itself pulls only the two
                             vcruntime DLLs. concrt140, vccorlib140,
                             msvcp140_1, msvcp140_2, msvcp140_atomic_wait and
                             msvcp140_codecvt_ids are satellite DLLs that a
                             consuming binary imports DIRECTLY when it uses the
                             matching STL feature (std::atomic wait, codecvt
                             facet ids, ...); none of ours does. Re-verify
                             after adding a C++ dependency with:
                               dumpbin -dependents <exe> | findstr /i 140
                             and extend this component plus the workflow's
                             staging list together if a new name appears.
                             installer-smoke asserts the three by name. The
                             release
                             roomlerd.exe links the CRT dynamically (its C++
                             encoder objects; the vcpkg static-md policy keeps
                             /MD), so a fresh Windows box without any VC++
                             redistributable popped "vcruntime140_1.dll was
                             not found" on the first daemon run (field report
                             2026-07-28). The EXE dir is first in the DLL
                             search path, so shipping the DLLs here makes the
                             install self-contained for roomlerd.exe,
                             roomler.exe AND the roomler-desktop companion
                             placed beside them. Staged into target\release by
                             the workflow's VC++ runtime step. One component
                             for the whole set (the DLLs ship and upgrade as a
                             unit); HKCU KeyPath like siblings (ICE38,
                             user-profile dir). -->
                        <Component Id='VcRedistCrt' Guid='F120B201-E45A-422D-80FE-A5C0B77AF8EC'>
                            <RegistryValue
                                Root='HKCU'
                                Key='Software\Roomler\Agent'
                                Name='installed_vcredist_crt'
                                Type='integer'
                                Value='1'
                                KeyPath='yes' />
                            <File Id='crt_msvcp140' Name='msvcp140.dll' DiskId='1' Source='target\release\msvcp140.dll' />
                            <File Id='crt_vcruntime140' Name='vcruntime140.dll' DiskId='1' Source='target\release\vcruntime140.dll' />
                            <File Id='crt_vcruntime140_1' Name='vcruntime140_1.dll' DiskId='1' Source='target\release\vcruntime140_1.dll' />
                        </Component>
                    </Directory>
                </Directory>
            </Directory>

            <!-- Start Menu shortcut (already HKCU-keyed, already cleans up) -->
            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ProgramMenuSubfolder' Name='Roomler'>
                    <Component Id='ApplicationShortcut' Guid='6D3F4A02-8B5E-4D4C-B03F-9C4D5E6F7081'>
                        <!-- FR-133 P1: the Start-menu entry's NAME follows the
                             product's; its Id and the component's Guid are identity
                             and stay. MajorUpgrade runs afterInstallInitialize, so
                             the old product (and its old .lnk) is removed before
                             this one installs. #3292: it starts the task, through
                             the launcher, so a click opens no terminal and never
                             leaves a daemon nothing supervises. -->
                        <Shortcut
                            Id='AgentShortcut'
                            Name='Roomler'
                            Description='Roomler Daemon — private mesh network + secure remote control'
                            Target='[APPLICATIONFOLDER]roomlerdw.exe'
                            Arguments='service start'
                            WorkingDirectory='APPLICATIONFOLDER' />
                        <RemoveFolder Id='CleanupProgramMenuSubfolder' On='uninstall' />
                        <RegistryValue
                            Root='HKCU'
                            Key='Software\Roomler\Agent'
                            Name='installed'
                            Type='integer'
                            Value='1'
                            KeyPath='yes' />
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Complete'
            Title='Roomler'
            Description='Roomler Daemon — keeps this device on your private Roomler mesh network and available for secure remote control.'
            Display='expand'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            InstallDefault='local'
            Absent='disallow'>
            <ComponentRef Id='AgentExe' />
            <!-- P4b: tunnel CLI + user-PATH append. -->
            <ComponentRef Id='TunnelExe' />
            <!-- #3292: the windowless launcher. -->
            <ComponentRef Id='LauncherExe' />
            <ComponentRef Id='LicenseTxt' />
            <ComponentRef Id='ReadmeTxt' />
            <ComponentRef Id='WintunDll' />
            <ComponentRef Id='VcRedistCrt' />
            <ComponentRef Id='ApplicationShortcut' />
        </Feature>

        <Property Id='ARPHELPLINK' Value='https://roomler.ai/' />
        <Property Id='ARPURLINFOABOUT' Value='https://roomler.ai/' />

        <!--
          Postinstall hook: register the Scheduled Task auto-start
          immediately after the EXE lands on disk. Runs deferred +
          impersonated as the installing user (default for perUser
          MSIs) so the task is registered against their account.
          Return="ignore" so a registration failure (e.g. existing
          task with a tightened ACL) doesn't fail the install — the
          operator can recover with manual schtasks /Delete and
          re-run `service install`.
        -->
        <CustomAction
            Id='RegisterAutostart'
            FileKey='roomlerdw_exe'
            ExeCommand='service install'
            Execute='deferred'
            Impersonate='yes'
            Return='ignore' />

        <!--
          Symmetric uninstall hook: tear down the Scheduled Task
          BEFORE the EXE is removed from disk (the action shells
          out to the EXE itself, so it must still be present).
          Only fires during full uninstall (REMOVE="ALL"); a
          maintenance/repair leaves the task alone.
        -->
        <CustomAction
            Id='UnregisterAutostart'
            FileKey='roomlerdw_exe'
            ExeCommand='service uninstall'
            Execute='deferred'
            Impersonate='yes'
            Return='ignore' />

        <!--
          #3292: stop a running daemon at an uninstall. Restart Manager does not:
          the daemon declines its ENDSESSION_CLOSEAPP on purpose
          (docs/ephemeral-nodes.md), the log still says "Successfully shut down all
          applications", there is no event 10002, and the daemon runs on (measured
          0.4.196 to 0.4.197). Without this action an uninstall exits 0 and leaves it
          running with its files gone. A plain `service stop`, so an ephemeral device
          removes itself: it is leaving. It asks through the daemon's stop event and
          otherwise ends the task, whose kill-on-close job takes the daemon.
          Return="ignore" because a failure here must not fail an uninstall.
        -->
        <CustomAction
            Id='StopDaemon'
            FileKey='roomlerdw_exe'
            ExeCommand='service stop'
            Execute='deferred'
            Impersonate='yes'
            Return='ignore' />

        <!--
          #3292: the stop on an upgrade, from the NEW product, so it also reaches a
          daemon from a release without these actions. Otherwise that daemon stays in
          its terminal on renamed files until the next sign-in, and the new task's
          one-shots exit 8. The for-upgrade flag records an update attempt first: a
          stop during an upgrade must not unenroll an ephemeral device (#1683,
          updater::should_self_unenroll).
        -->
        <CustomAction
            Id='StopOldDaemon'
            FileKey='roomlerdw_exe'
            ExeCommand='service stop --for-upgrade'
            Execute='deferred'
            Impersonate='yes'
            Return='ignore' />

        <!--
          rc.18: cross-flavour cleanup. When the operator installs the
          perUser MSI over a prior perMachine install, this CA shells
          out to the freshly-laid EXE to scrub the OTHER flavour's
          stale artefacts (SCM service, service-log dir under
          %PROGRAMDATA%). Runs Impersonated as the installing user;
          service control needs admin so this is best-effort: a
          non-admin user couldn't have had a live perMachine install
          anyway. Return="ignore" so a cleanup glitch doesn't sink
          the install (the on-disk EXE itself takes priority).
          Same-flavour invocations (perUser over perUser) exit 0 via
          the helper's fast-path.
        -->
        <CustomAction
            Id='CleanupLegacyPerMachine'
            FileKey='roomlerdw_exe'
            ExeCommand='cleanup-legacy-install --target-flavour perUser'
            Execute='deferred'
            Impersonate='yes'
            Return='ignore' />

        <InstallExecuteSequence>
            <!--
              Run RegisterAutostart on every fresh install, repair,
              and MajorUpgrade. Skip during full uninstall — there's
              nothing to register and the EXE is about to be deleted
              anyway. The condition leaves it active for upgrade
              installs (which are technically "REMOVE=ALL" of the
              old + install of the new, scheduled separately).
              #3292: last before the commit, because the task it writes
              names the launcher. A failure after it rolls an upgrade from
              a release without the launcher back to that release, and a
              task left pointing at a file the rollback removed starts
              nothing at any logon.
            -->
            <Custom Action='RegisterAutostart' Before='InstallFinalize'>
                NOT (REMOVE="ALL")
            </Custom>
            <!--
              rc.18: scrub stale artefacts AFTER the new EXE lands
              (so we can shell out to it). This now runs before
              RegisterAutostart. Ordering is immaterial: the helper's
              CA-reachable step only sweeps the vacated pre-rename
              install dir (P4b), and its cross-flavour arms — which
              touch the other flavour's task/service namespace — are
              never reached from the CA (same-flavour fast path; see
              install_cleanup.rs module docs). Skip during uninstall.
            -->
            <Custom Action='CleanupLegacyPerMachine' After='InstallFiles'>
                NOT (REMOVE="ALL")
            </Custom>
            <!--
              #3292: after InstallFiles, because it runs the new launcher. The
              updater's daemon has already left, so there it finds no event, and no
              task to end either, the old one being gone and the new one not yet
              written. A repair or a fresh install has no WIX_UPGRADE_DETECTED and
              leaves a running daemon alone.
            -->
            <Custom Action='StopOldDaemon' After='CleanupLegacyPerMachine'>
                WIX_UPGRADE_DETECTED
            </Custom>
            <!--
              Run UnregisterAutostart only during full uninstall,
              and BEFORE RemoveFiles so the EXE we shell out to is
              still on disk.
            -->
            <Custom Action='UnregisterAutostart' Before='RemoveFiles'>
                REMOVE="ALL"
            </Custom>
            <!--
              #3292: BEFORE UnregisterAutostart, because deleting the task orphans
              a running instance and `service stop` falls back to ending that task.
              REMOVE="ALL" also holds for the OLD product during a MajorUpgrade,
              which UPGRADINGPRODUCTCODE tells apart: an upgrade's stop is
              StopOldDaemon, and it must not be this plain one.
            -->
            <Custom Action='StopDaemon' Before='UnregisterAutostart'>
                REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE
            </Custom>
        </InstallExecuteSequence>
    </Product>
</Wix>
<!-- RETIRED-NAME-ANCHOR-END -->
